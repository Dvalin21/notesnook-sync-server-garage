# Notesnook Sync Server — Garage S3 Backend
# Self-hosted Notesnook sync server with Garage S3 storage.
# Fork of streetwriters/notesnook-sync-server (Dvalin21 variant).
#
# Differences from the MinIO version:
# - S3 storage uses Garage (dxflrs/garage:v2.1.0) instead of MinIO
# - S3 console at garage.<SERVER_DOMAIN> instead of minio.<SERVER_DOMAIN>
# - S3 API at attach.<SERVER_DOMAIN> (same as MinIO version — app uses this)
# - No MinIO container — saves resources
#
# Prerequisites:
# - Docker + Docker Compose v2
# - Domain with DNS control (e.g. example.com)
# - TLS reverse proxy (Nginx Proxy Manager, Caddy, nginx, etc.)
# - SMTP server (optional — for email 2FA / password reset)
#
# Architecture:
#   External TLS proxy → host:8080 → Caddy :80 → routes by Host header
#   Only port 8080 is exposed to the host.
#   All service ports (5264, 8264, 7264, 3000, 3900) are INTERNAL ONLY.
#
# Subdomains (all under your SERVER_DOMAIN):
#   auth.<domain>   → identity-server:8264   (OIDC / login)
#   sync.<domain>   → notesnook-server:5264  (note sync)
#   sse.<domain>    → sse-server:7264        (server-sent events)
#   notes.<domain>  → monograph-server:3000  (web client)
#   attach.<domain> → garage:3900            (S3 attachments API)
#   garage.<domain> → garage:3900            (S3 console UI)
#   cors.<domain>   → cors-proxy:3000        (CORS proxy)
#
# The apex domain (<domain>) is NOT part of this stack.
# If your apex hosts your own website on a different server, leave it alone.

# ── Server identity ──────────────────────────────────────────────────
INSTANCE_NAME=CHANGEME-my-notesnook

# ── API security ─────────────────────────────────────────────────────
# Auth token signing/validation secret. Generate with:
#   openssl rand -base64 48
# MUST be set before the stack will start.
NOTESNOOK_API_SECRET=CHANGEME-replace-with-openssl-rand-base64-48

# ── Signup control ───────────────────────────────────────────────────
# false = anyone can create an account (use temporarily to create your first account)
# true  = no new accounts can be created (set after creating your account)
DISABLE_SIGNUPS=false

# ── Public URLs (REQUIRED) ───────────────────────────────────────────
# These tell the Notesnook app and web client how to reach each service.
# Use https:// and your real domain. Must match your TLS proxy / Caddy routing.
#
# The Android app uses these when you configure "Custom server" in Settings → Sync.

# Auth / Identity server — used by the app for login/OAuth
# Caddy routes auth.<SERVER_DOMAIN> → identity-server:8264
AUTH_SERVER_PUBLIC_URL=https://auth.example.com

# Sync server — used by the app for note sync
# Caddy routes sync.<SERVER_DOMAIN> → notesnook-server:5264
NOTESNOOK_APP_PUBLIC_URL=https://sync.example.com

# Monograph web client
# Caddy routes notes.<SERVER_DOMAIN> → monograph-server:3000
MONOGRAPH_PUBLIC_URL=https://notes.example.com

# S3 attachments API — used by the app to upload/download attachments
# Caddy routes attach.<SERVER_DOMAIN> → garage:3900 (Garage S3)
ATTACHMENTS_SERVER_PUBLIC_URL=https://attach.example.com

# ── Caddy / domain configuration ─────────────────────────────────────
# Your domain (e.g. "example.com"). Used by Caddy for Host header routing.
# The stack generates subdomains automatically: auth., sync., sse., notes.,
# attach., garage., cors. — all under this domain.
SERVER_DOMAIN=example.com

# ── SMTP (email) — optional ──────────────────────────────────────────
# Required only if you want email-based 2FA or password reset emails.
# Leave blank if you don't need email features.
# The validate service will print a WARNING if these are empty but will
# still allow the stack to start.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Notesnook

# ── Garage S3 credentials (REQUIRED) ────────────────────────────────
# Garage is the S3 backend for this version (replaces MinIO).
# GARAGE_RPC_SECRET: 32-byte hex for Garage RPC encryption.
#   Generate with: openssl rand -hex 32
# GARAGE_ACCESS_KEY_ID / GARAGE_ACCESS_KEY_SECRET: S3 credentials.
#   Generate with: openssl rand -base64 12 / openssl rand -base64 24
GARAGE_RPC_SECRET=CHANGEME-replace-with-openssl-rand-hex-32
GARAGE_ACCESS_KEY_ID=CHANGEME-replace-with-openssl-rand-base64-12
GARAGE_ACCESS_KEY_SECRET=CHANGEME-replace-with-openssl-rand-base64-24

# ── CORS proxy ───────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins for the CORS proxy.
# Default "*" allows all origins. Set to your specific domains for tighter security.
NOTESNOOK_CORS_ORIGINS=*

# ── Twilio SMS 2FA (OPTIONAL) ────────────────────────────────────────
# Leave empty if you don't use SMS-based 2FA.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
